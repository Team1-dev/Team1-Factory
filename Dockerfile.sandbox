FROM node:22-bookworm-slim

RUN apt-get update \
	&& apt-get install -y --no-install-recommends git jq curl ca-certificates build-essential procps file sudo \
	&& rm -rf /var/lib/apt/lists/* \
	&& corepack enable

# Claude Code will not run unattended as root, so the runner is an ordinary user who may sudo: a card's sandbox is thrown away.
RUN useradd --create-home --shell /bin/bash team1 \
	&& echo 'team1 ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/team1 \
	&& chmod 0440 /etc/sudoers.d/team1

USER team1
# Where a repository's .NET and Go go when its environment is built, so every command finds them.
ENV PATH=/home/team1/.local/bin:/home/team1/.dotnet:/home/team1/.dotnet/tools:/usr/local/go/bin:$PATH \
	DOTNET_ROOT=/home/team1/.dotnet DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
# One package store for every command, whatever its HOME: pnpm otherwise picks one on the card's work volume and asks to reinstall
# node_modules the warm image built, and a prompt nobody can answer aborts it.
ENV pnpm_config_store_dir=/home/team1/.local/share/pnpm/store pnpm_config_confirm_modules_purge=false \
	NUGET_PACKAGES=/home/team1/.nuget/packages
RUN curl -fsSL https://claude.ai/install.sh | bash
# Where a card's checkout, its build outputs and Claude's sessions live.
RUN mkdir /home/team1/work

USER root
COPY src/runner.mjs src/shell.mjs /runner/src/
COPY scripts /runner/scripts/
USER team1
WORKDIR /home/team1

CMD ["node", "/runner/src/runner.mjs"]
