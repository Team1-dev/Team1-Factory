{
  "name": "team1-software-factory",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/service.mjs start",
    "stop": "node --env-file-if-exists=.env src/service.mjs stop",
    "logs": "node --env-file-if-exists=.env src/service.mjs logs",
    "status": "node --env-file-if-exists=.env src/service.mjs status",
    "tick": "node --env-file-if-exists=.env src/poll.mjs --once",
    "test": "vitest run --project unit --project integration",
    "test:e2e": "vitest run --project e2e --reporter=verbose",
    "sandbox": "node --env-file-if-exists=.env scripts/sandbox.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "vitest": "^5.0.1"
  }
}
